# ─────────────────────────────────────────────────
# U-Turn4Nature PIC Portal — PRODUCTION Environment Variables
# Copy this to .env and fill in ALL values before deploying
# ─────────────────────────────────────────────────

# ── Server ──────────────────────────────────────
NODE_ENV=production
PORT=5000
FRONTEND_URL=https://yourdomain.com

# ── Database ─────────────────────────────────────
# Use your Neon/Supabase/Railway PostgreSQL URL
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# ── JWT ──────────────────────────────────────────
# MUST be at least 32 random characters — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=GENERATE_A_RANDOM_64_CHAR_HEX_STRING_HERE
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# ── Admin Seed ───────────────────────────────────
ADMIN_SEED_EMAIL=your-admin@yourdomain.com
ADMIN_SEED_PASSWORD=YourSecureAdminPassword123!
ADMIN_SEED_NAME=Admin Name
ADMIN_SEED_PHONE=9999999999

# ── Email (SMTP) ─────────────────────────────────
# Gmail: Enable 2FA → Create App Password at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM_NAME=U-Turn4Nature
EMAIL_FROM_ADDRESS=noreply@yourdomain.com

# ── Shopify ──────────────────────────────────────
# Get these from Shopify Admin → Apps → Develop Apps
SHOPIFY_STORE_URL=your-store.myshopify.com
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SHOPIFY_ACCESS_TOKEN=shpat_your_access_token
SHOPIFY_WEBHOOK_SECRET=your_webhook_secret

# ── Encryption ──────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=GENERATE_A_RANDOM_64_CHAR_HEX_STRING_HERE

# ── Referral ─────────────────────────────────────
REFERRAL_BASE_URL=https://yourdomain.com
COMMISSION_RATE=5

# ── File Uploads ─────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# ── Rate Limiting ────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
