# ─────────────────────────────────────────────────
# U-Turn4Nature PIC Portal — Backend Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────

# ── Server ──────────────────────────────────────
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# ── Database ─────────────────────────────────────
DATABASE_URL="postgresql://username:password@localhost:5432/uturn4nature_pic?schema=public"

# ── JWT ──────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_long
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# ── Admin Seed ───────────────────────────────────
ADMIN_SEED_EMAIL=admin@uturn4nature.com
ADMIN_SEED_PASSWORD=Admin@123456
ADMIN_SEED_NAME=Super Admin

# ── Email (SMTP) ─────────────────────────────────
# For Gmail: use App Password (not your account password)
# For SendGrid: use apikey as the user, API key as pass
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM_NAME=U-Turn4Nature
EMAIL_FROM_ADDRESS=noreply@uturn4nature.com

# ── Shopify ──────────────────────────────────────
SHOPIFY_STORE_URL=your-store.myshopify.com
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SHOPIFY_ACCESS_TOKEN=your_shopify_access_token
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret

# ── Encryption (for storing Shopify keys in DB) ──
ENCRYPTION_KEY=your_32_char_aes_encryption_key_here

# ── Referral ─────────────────────────────────────
REFERRAL_BASE_URL=https://uturn4nature.com
COMMISSION_RATE=5

# ── File Uploads ─────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# ── Rate Limiting ────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
